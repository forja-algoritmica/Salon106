# Copia este archivo a .env y llena los valores. NO subas .env a GitHub.

# --- Base de datos (Supabase) ---
DB_HOST=aws-0-us-east-2.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
# Con el pooler el usuario es  rol.ID_DEL_PROYECTO
DB_USER=pipeline_rw.TU_ID_DE_PROYECTO
DB_PASSWORD=
DB_SSLMODE=require

# --- Solo para el equipo de ML ---
DB_SCHEMA=public
DB_TABLE=v_entrenamiento_piezas
DB_TARGET=defectuosa

# --- Parametros de los scripts ---
INTERVALO_SEGUNDOS=5
INTERVALO_ML_SEGUNDOS=600
# 0 = entrenar solo si no hay modelo; otro valor = reentrenar cada N segundos
ENTRENAR_CADA_SEGUNDOS=0
# Carpeta de artefactos del ML. En docker-compose ya se fija a /artefactos.
# ML_DIR_ARTEFACTOS=.

# --- Solo para el plan B local (docker compose --profile local up) ---
# Usa DB_HOST=db_local, DB_PORT=5432, DB_USER=pipeline_rw, DB_SSLMODE=disable
# y como DB_PASSWORD la que pongas en docs/supabase_setup.sql
POSTGRES_PASSWORD_LOCAL=solo_para_desarrollo_local
